  <tag k="description" v="In 1977 U.S. Coast Guard became the first U.S. military branch to assign women on an unrestricted basis on ships. USCGC GALLATIN whose homeport was here at Governor's Island, New York was the first U.S. military ship with women assigned permanently."/>
  <tag k="fixme" v="Check if it still exists, survey needed. Also, is it information board or memorial plaque? (previously had historic district tag, likely by accident)"/>
  <tag k="image" v="https://en.wikipedia.org/wiki/NNS_Okpabana#/media/File:USCGC_Gallatin_WHEC_721.jpg"/>
  <tag k="name" v="Coast Guard Women's History"/>
  <tag k="source_ref" v="http://governorsislandguide.com/?p=743"/>
  <tag k="website" v="https://www.history.uscg.mil/Browse-by-Topic/Notable-People/Women/"/>
 </node>
